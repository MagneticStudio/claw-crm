# Database
DATABASE_URL=postgresql://user:password@localhost:5432/claw_crm

# Session
SESSION_SECRET=change-this-to-a-random-string

# Direct local runs bind to localhost. Set only for deliberate network access.
# HOST=0.0.0.0
# Docker and Railway set their own non-loopback listener for container ingress.

# Optional: MCP token override (if not set, uses token from DB settings)
# MCP_TOKEN=your-secret-token

# MCP Client (for local stdio mode — see README)
# CRM_URL=http://localhost:3000
# CRM_API_KEY=your-api-key-from-settings
